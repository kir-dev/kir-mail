generator client {
  provider = "prisma-client"
  output   = "../apps/gateway/src/generated"
}

datasource db {
  provider = "postgresql"
}

model Token {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  value     String
  quota     Int      @default(0)
  used      Int      @default(0)
}
